{
  "name": "trip-share",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @workspace/share-brasil start",
    "android": "pnpm --filter @workspace/share-brasil android",
    "ios": "pnpm --filter @workspace/share-brasil ios",
    "web": "pnpm --filter @workspace/share-brasil web",
    "build": "pnpm typecheck && pnpm --filter @workspace/share-brasil-pwa build",
    "build:native": "pnpm --filter @workspace/share-brasil build",
    "typecheck": "pnpm --filter @workspace/share-brasil typecheck",
    "test": "pnpm --filter @workspace/share-brasil test",
    "test:web": "pnpm --filter @workspace/share-brasil test:web"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
