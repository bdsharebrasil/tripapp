# Copie para .env e ajuste se necessário.
#
# Base da API consumida por src/lib/api.ts.
# - Produção: https://api-workers.sharebrasil.workers.dev
# - Domínio customizado do mesmo Worker: https://api.share-brasil.com
#
# ATENÇÃO: variáveis EXPO_PUBLIC_* são embutidas no bundle e podem ser lidas
# por qualquer pessoa que inspecione o app. Nunca coloque segredo, token de
# serviço ou chave privada aqui.
EXPO_PUBLIC_API_URL=https://api-workers.sharebrasil.workers.dev

# Supabase Auth. Use a URL do projeto e a chave publicável/anon (não service_role).
# EXPO_PUBLIC_* é incorporado ao bundle e é público por natureza.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<public-anon-or-publishable-key>
